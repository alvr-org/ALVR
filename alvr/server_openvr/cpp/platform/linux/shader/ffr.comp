#version 450

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout (binding = 0) uniform sampler2D in_img;
layout (binding = 1, rgba8) uniform writeonly image2D out_img;

layout (constant_id = 0) const float eyeSizeRatioX = 0.;
layout (constant_id = 1) const float eyeSizeRatioY = 0.;
layout (constant_id = 2) const float centerSizeX = 0.;
layout (constant_id = 3) const float centerSizeY = 0.;
layout (constant_id = 4) const float edgeRatioX = 0.;
layout (constant_id = 5) const float edgeRatioY = 0.;

const vec2 eyeSizeRatio = vec2(eyeSizeRatioX, eyeSizeRatioY);
const vec2 centerSize = vec2(centerSizeX, centerSizeY);
const vec2 edgeRatio = vec2(edgeRatioX, edgeRatioY);

// Rotational reprojection from the pose the frame was rendered with to the
// newest tracking pose, folded into this pass so the warp costs no extra
// resample. rotation is the source-from-destination view rotation
// (R_render^T * R_latest), applied to each output pixel's view ray.
// Tangents are (tanLeft, tanRight, tanUp, tanDown) per eye; view space is
// +x right, +y up, forward -z; image v grows downward so v=0 maps to tan(up).
// enabled == 0 leaves this shader's output bit-identical to the unwarped one.
// The per-eye foveation center shifts follow the warp in the same block, since
// a shader can declare only one push-constant block. Offsets match
// PushConstants in Renderer.hpp.
layout (push_constant) uniform PushConstants {
    mat4 rotation;
    vec4 leftTans;
    vec4 rightTans;
    uint enabled;
    layout (offset = 112) vec2 centerShiftLeft;
    layout (offset = 120) vec2 centerShiftRight;
} pc;

// eyeUV must be in true left-to-right orientation (not the mirrored space
// TextureToEyeUV produces for the right eye).
vec2 WarpEyeUV(vec2 eyeUV, bool isRightEye)
{
    vec4 tans = isRightEye ? pc.rightTans : pc.leftTans;
    vec3 ray = vec3(mix(tans.x, tans.y, eyeUV.x), mix(tans.z, tans.w, eyeUV.y), -1.);
    vec3 src = mat3(pc.rotation) * ray;
    vec2 ndc = src.xy / -src.z;
    return vec2((ndc.x - tans.x) / (tans.y - tans.x), (ndc.y - tans.z) / (tans.w - tans.z));
}

vec2 TextureToEyeUV(vec2 textureUV, bool isRightEye)
{
    // flip distortion horizontally for right eye
    // left: x * 2; right: (1 - x) * 2
    return vec2((textureUV.x + float(isRightEye) * (1. - 2. * textureUV.x)) * 2., textureUV.y);
}

vec2 EyeToTextureUV(vec2 eyeUV, bool isRightEye)
{
    // saturate is used to avoid color bleeding between the two sides of the texture or with the
    // black border when filtering
    // vec2 clampedUV = saturate(eyeUV);
    // left: x / 2; right 1 - (x / 2)
    // return vec2(clampedUV.x / 2. + float(isRightEye) * (1. - clampedUV.x), clampedUV.y);
    return vec2(eyeUV.x * .5 + float(isRightEye) * (1. - eyeUV.x), eyeUV.y);
}

float CompressAxis(float eyeUV, float centerSizeAxis, float centerShiftAxis, float edgeRatioAxis)
{
    float c0 = (1. - centerSizeAxis) * .5;
    float c1 = (edgeRatioAxis - 1.) * c0 * (centerShiftAxis + 1.) / edgeRatioAxis;
    float c2 = (edgeRatioAxis - 1.) * centerSizeAxis + 1.;

    float loBound = c0 * (centerShiftAxis + 1.) / c2;
    float hiBound = c0 * (centerShiftAxis - 1.) / c2 + 1.;
    float center = eyeUV * c2 / edgeRatioAxis + c1;

    if (eyeUV < loBound) {
        float d2 = eyeUV * c2;
        float g1 = eyeUV / max(loBound, 1e-6);
        return g1 * center + (1. - g1) * d2;
    }

    if (eyeUV > hiBound) {
        float d3 = (eyeUV - 1.) * c2 + 1.;
        float g2 = (1. - eyeUV) / max(1. - hiBound, 1e-6);
        return g2 * center + (1. - g2) * d3;
    }

    return center;
}

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(pos) + 0.5f) / imageSize(out_img);

    bool isRightEye = uv.x > 0.5;
    vec2 eyeUV = TextureToEyeUV(uv, isRightEye) / eyeSizeRatio;
    vec2 centerShift = isRightEye ? pc.centerShiftRight : pc.centerShiftLeft;

    vec2 compressedUV = vec2(
        CompressAxis(eyeUV.x, centerSize.x, centerShift.x, edgeRatio.x),
        CompressAxis(eyeUV.y, centerSize.y, centerShift.y, edgeRatio.y)
    );

    vec2 sampleUV = EyeToTextureUV(compressedUV, isRightEye);

    if (pc.enabled != 0) {
        // compressedUV is in the mirrored per-eye space for the right eye;
        // the ray math needs true orientation, so unmirror, warp, remirror.
        vec2 warpUV = compressedUV;
        if (isRightEye) {
            warpUV.x = 1. - warpUV.x;
        }
        warpUV = WarpEyeUV(warpUV, isRightEye);
        if (isRightEye) {
            warpUV.x = 1. - warpUV.x;
        }
        sampleUV = EyeToTextureUV(warpUV, isRightEye);

        // Keep the sample inside this eye's half of the shared texture, half a
        // texel in on both axes. The sampler addresses eRepeat, so a coordinate
        // outside the image wraps to the opposite edge rather than clamping,
        // and the half-texel inset keeps the bilinear taps off the wrapped row.
        vec2 texel = 1. / vec2(textureSize(in_img, 0));
        vec2 lo = vec2(float(isRightEye) * .5 + .5 * texel.x, .5 * texel.y);
        vec2 hi = vec2(.5 + float(isRightEye) * .5 - .5 * texel.x, 1. - .5 * texel.y);
        sampleUV = clamp(sampleUV, lo, hi);
    }

    imageStore(out_img, pos, texture(in_img, sampleUV));
}
