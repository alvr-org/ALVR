#version 450

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout (binding = 0) uniform sampler2D in_img;
layout (binding = 1, rgba8) uniform writeonly image2D out_img;

// Rotational reprojection from the pose the frame was rendered with to the
// newest tracking pose, folded into this pass so the warp costs no extra
// resample. rotation is the source-from-destination view rotation
// (R_render^T * R_latest), applied to each output pixel's view ray.
// Tangents are (tanLeft, tanRight, tanUp, tanDown) per eye; view space is
// +x right, +y up, forward -z; image v grows downward so v=0 maps to tan(up).
// enabled == 0 leaves this shader's output bit-identical to the unwarped one.
layout (push_constant) uniform Rewarp {
    mat4 rotation;
    vec4 leftTans;
    vec4 rightTans;
    uint enabled;
} pc;

vec2 WarpEyeUV(vec2 eyeUV, bool isRightEye)
{
    vec4 tans = isRightEye ? pc.rightTans : pc.leftTans;
    vec3 ray = vec3(mix(tans.x, tans.y, eyeUV.x), mix(tans.z, tans.w, eyeUV.y), -1.);
    vec3 src = mat3(pc.rotation) * ray;
    vec2 ndc = src.xy / -src.z;
    return vec2((ndc.x - tans.x) / (tans.y - tans.x), (ndc.y - tans.z) / (tans.w - tans.z));
}

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    vec2 npos = (vec2(pos) + 0.5f) / imageSize(out_img);

    if (pc.enabled != 0) {
        bool isRightEye = npos.x > 0.5;
        vec2 eyeUV = vec2(npos.x * 2. - float(isRightEye), npos.y);
        eyeUV = WarpEyeUV(eyeUV, isRightEye);
        // Repack into this eye's half of the shared texture, clamped half a
        // texel inside it so filtering never bleeds across the stereo seam.
        vec2 texel = 1. / vec2(textureSize(in_img, 0));
        vec2 srcUV = vec2(eyeUV.x * .5 + float(isRightEye) * .5, eyeUV.y);
        vec2 lo = vec2(float(isRightEye) * .5 + .5 * texel.x, .5 * texel.y);
        vec2 hi = vec2(.5 + float(isRightEye) * .5 - .5 * texel.x, 1. - .5 * texel.y);
        npos = clamp(srcUV, lo, hi);
    }

    vec4 res = texture(in_img, npos);
    imageStore(out_img, pos, res);
}
